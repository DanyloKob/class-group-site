# Скопіюйте цей файл у .env і заповніть значення. .env у git не потрапляє.

DATABASE_URL="postgresql://postgres:devpass@localhost:5432/classgroup?schema=public"

# Отримуєте через @BotFather (див. план) - без цього реальний Telegram-вхід
# не працює, але dev-логін і решта застосунку працюють і без нього.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Вмикає dev-логін (обхід Telegram для локальної розробки).
# НІКОЛИ не вмикайте це в проді - окрім цього прапорця, next build
# також жорстко забороняє його через NODE_ENV=production.
DEV_LOGIN_ENABLED="true"

# На порту 8080/8090 автоматично логінить під сідженим користувачем з цим
# номером телефону. Лишити порожнім на 8091 - там за замовчуванням
# неавторизований екран.
DEV_LOGIN_AUTO_PHONE=""

# Необов'язково. Каталог для завантажених аватарів і фото «Спогадів».
# У проді має лежати поза .next/standalone (його стирає кожен деплой).
# Порожнє значення = public/uploads у корені проєкту.
UPLOADS_DIR=""

# Публічна адреса сайту без скісної риски в кінці. Потрібна для кнопки «Відкрити в Microsoft»:
# сервіс Microsoft завантажує файл саме за цією адресою, тож вона має бути доступна з інтернету.
PUBLIC_BASE_URL="https://2025-3.pp.ua"

# Каталог для файлів «Проєктів» (PDF, PPTX і готові слайди). Поза public/, поза .next/standalone
# і не всередині UPLOADS_DIR. У розробці порожнє значення = storage/materials. У проді обов'язково.
MATERIALS_DIR=""

# LibreOffice для перетворення PPTX у PDF. Порожнє значення = /usr/bin/soffice.
SOFFICE_PATH=""
# Необов'язково: ліміт часу на одне перетворення, мс (типово 120000).
CONVERSION_TIMEOUT_MS=""

# Пісочниця для LibreOffice (PPTX завантажують користувачі, тож файл не довіряємо).
# bwrap (типово, порожнє значення): кожне перетворення йде в bubblewrap без мережі, без доступу
# до застосунку, його .env, домашніх тек і чужих матеріалів. Якщо bwrap немає або він не пройшов
# самоперевірку, перетворення позначаються як невдалі й НІКОЛИ не запускаються без пісочниці.
# off: без пісочниці, лише для розробки (у журналі гучне попередження; у проді заборонено).
CONVERTER_SANDBOX=""
# Шлях до bwrap. Порожнє значення = /usr/bin/bwrap.
BWRAP_PATH=""

# Лише для prisma/seed.production.ts: перший суперадмін свіжої прод-бази.
SEED_SUPERADMIN_PHONE="+380XXXXXXXXX"
SEED_SUPERADMIN_LAST_NAME=""
SEED_SUPERADMIN_FIRST_NAME=""
