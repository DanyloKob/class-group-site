# Скопіюйте цей файл у .env і заповніть значення. .env у git не потрапляє.

DATABASE_URL="postgresql://postgres:devpass@localhost:5432/classgroup?schema=public"

# Отримуєте через @BotFather (див. план) — без цього реальний Telegram-вхід
# не працює, але dev-логін і решта застосунку працюють і без нього.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Вмикає dev-логін (обхід Telegram для локальної розробки).
# НІКОЛИ не вмикайте це в проді — окрім цього прапорця, next build
# також жорстко забороняє його через NODE_ENV=production.
DEV_LOGIN_ENABLED="true"

# На порту 8080/8090 автоматично логінить під сідженим користувачем з цим
# номером телефону. Лишити порожнім на 8091 - там за замовчуванням
# неавторизований екран.
DEV_LOGIN_AUTO_PHONE=""

# Web push. Згенерувати одну пару на весь застосунок: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY і NEXT_PUBLIC_VAPID_PUBLIC_KEY - те саме значення (друге
# потрапляє в клієнтський бандл, перше лишається лише на сервері поруч з
# приватним ключем). VAPID_SUBJECT - контактний URL або mailto:, вимагає протокол.
VAPID_SUBJECT="https://2025-3.pp.ua"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Необов'язково. Каталог для завантажених аватарів і фото «Спогадів».
# У проді має лежати поза .next/standalone (його стирає кожен деплой).
# Порожнє значення = public/uploads у корені проєкту.
UPLOADS_DIR=""

# Лише для prisma/seed.production.ts: перший суперадмін свіжої прод-бази.
SEED_SUPERADMIN_PHONE="+380XXXXXXXXX"
SEED_SUPERADMIN_LAST_NAME=""
SEED_SUPERADMIN_FIRST_NAME=""
