generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────

enum ScheduleGroup {
  A
  B
}

enum LoginStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

// "чисельник" / "знаменник" — the alternating two-week schedule cycle.
enum WeekParity {
  NUMERATOR
  DENOMINATOR
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum ClassGroupScope {
  A
  B
  SHARED
}

enum DutyType {
  CAFETERIA
  BOARD
}

// ── User & Auth ──────────────────────────────────────────

model User {
  id               String         @id @default(cuid())
  phone            String         @unique
  lastName         String
  firstName        String

  // No role hierarchy: the superadmin is the one fixed "owner" flag (set
  // outside this UI, never toggled through it) - everyone else's abilities
  // are exactly these independent per-person switches, nothing implied by
  // any tier in between. The remaining flags are canManageDuty (assign duty)
  // and canPostMemories. Class templates and the numerator/denominator anchor
  // stay superadmin-only and are deliberately not grantable flags at all.
  isSuperAdmin    Boolean @default(false)
  canManageDuty   Boolean @default(false)
  canPostMemories Boolean @default(false)

  // Which half of the class this person sits in. Nothing reads it yet - it
  // is captured now so the roll is already complete when a per-group view
  // needs it.
  scheduleGroup     ScheduleGroup?

  telegramUserId   BigInt?        @unique
  telegramUsername String?
  avatarUrl        String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  loginRequests     TelegramLoginRequest[]
  sessions          Session[]
  auditLogs         AuditLog[]

  memoryPosts     MemoryPost[]
  memoryPostLikes MemoryPostLike[]

  dutyAssignments         DutyAssignment[]   @relation("DutyAssignmentPerson")
  dutyAssignmentsCreated  DutyAssignment[]   @relation("DutyAssignmentCreatedBy")
  classTemplatesCreated   ClassTemplate[]
  classOverridesCreated   ClassOverride[]
  scheduleSettingsEdits   ScheduleSettings[]

  projectTopics    ProjectTopic[]    @relation("ProjectTopicCreatedBy")
  projectMaterials ProjectMaterial[] @relation("ProjectMaterialAuthor")
}

model TelegramLoginRequest {
  id     String      @id @default(cuid())
  token  String      @unique
  status LoginStatus @default(PENDING)

  telegramChatId BigInt?
  telegramUserId BigInt?

  matchedUserId String?
  matchedUser   User?   @relation(fields: [matchedUserId], references: [id])
  failureReason String?

  consumedAt DateTime?
  ipAddress  String?
  userAgent  String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([status, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Memories (posts + photos) ────────────────────────────

model MemoryPost {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String?
  createdAt DateTime @default(now())

  images MemoryPostImage[]
  likes  MemoryPostLike[]

  @@index([authorId])
  @@index([createdAt])
}

model MemoryPostImage {
  id       String @id @default(cuid())
  postId   String
  url      String
  mimeType String
  order    Int
  width    Int?
  height   Int?

  post MemoryPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, order])
  @@index([postId])
}

model MemoryPostLike {
  userId       String
  memoryPostId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryPost MemoryPost @relation(fields: [memoryPostId], references: [id], onDelete: Cascade)

  @@id([userId, memoryPostId])
  @@index([memoryPostId])
}

// ── Schedule ──────────────────────────────────────────────

// Singleton row (id is always the literal string "singleton").
model ScheduleSettings {
  id               String     @id @default("singleton")
  parityAnchorDate DateTime   @db.Date
  parityAnchorType WeekParity
  updatedById      String?
  updatedBy        User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt        DateTime   @updatedAt
}

// One person on duty for one date and one duty type. Deliberately NOT a
// weekday+parity template: with 33 people rotating at the board and meals
// only on some days, no two-week cycle ever lined up - every day is entered
// explicitly, from the month editor in /schedule/admin/duty. Any number of
// people can share a date+dutyType; the row's absence is simply "no duty".
model DutyAssignment {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  dutyType    DutyType
  personId    String
  person      User     @relation("DutyAssignmentPerson", fields: [personId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("DutyAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([date, dutyType, personId])
  @@index([date])
  @@index([personId])
}

// Recurring default class, keyed by weekday + parity + slot (1-4) + scope.
model ClassTemplate {
  id          String          @id @default(cuid())
  weekday     Weekday
  parity      WeekParity
  slot        Int
  scope       ClassGroupScope
  subject     String
  teacher     String
  room        String
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([weekday, parity, slot, scope])
  @@index([weekday, parity])
}

// Exact-date override (substitution, cancellation, one-off split/merge).
model ClassOverride {
  id          String          @id @default(cuid())
  date        DateTime        @db.Date
  slot        Int
  scope       ClassGroupScope
  isCancelled Boolean         @default(false)
  subject     String?
  teacher     String?
  room        String?
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([date, slot, scope])
  @@index([date])
}

// ── Audit log ─────────────────────────────────────────────
// Deliberately covers only CREATE/DELETE, not UPDATE - the point is
// tracing who created or destroyed a piece of content (the row's own
// createdById/authorId already answers "who made this" for anything still
// live; a delete is exactly the moment that trail would otherwise vanish).

enum AuditAction {
  CREATE
  DELETE
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     AuditAction
  entityType String
  summary    String
  createdAt  DateTime    @default(now())

  @@index([createdAt])
}

enum MaterialKind {
  LINK
  PDF
  PPTX
}

// Only PPTX materials have a status (null for LINK/PDF): the background
// LibreOffice conversion that produces slides.pdf for the in-site presenter.
enum ConversionStatus {
  PENDING
  READY
  FAILED
}

// «Проєкти»: a topic with its due date. Any logged-in member can create one.
model ProjectTopic {
  id          String            @id @default(cuid())
  title       String
  subject     String?
  dueDate     DateTime          @db.Date
  createdById String
  createdBy   User              @relation("ProjectTopicCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  materials   ProjectMaterial[]

  @@index([dueDate])
  @@index([createdById])
}

// A link or a file (PDF/PPTX) under a topic. `token` is the public, unguessable
// /m/<token> address; files live on disk at paths derived from `id` only
// (see lib/server/materialStorage.ts), never from user input.
model ProjectMaterial {
  id                 String            @id @default(cuid())
  topicId            String
  topic              ProjectTopic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  token              String            @unique
  kind               MaterialKind
  text               String?
  url                String?
  fileName           String?
  fileSize           Int?
  conversionStatus   ConversionStatus?
  conversionError    String?
  conversionAttempts Int               @default(0)
  convertedAt        DateTime?
  authorId           String
  author             User              @relation("ProjectMaterialAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt          DateTime          @default(now())

  @@index([topicId, createdAt])
  @@index([conversionStatus])
  @@index([authorId])
}
