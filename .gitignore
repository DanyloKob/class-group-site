# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (per-port dev builds use .next-<port> to avoid the dev-server lock
# colliding across the 3 concurrently-running local instances, see next.config.ts)
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# production server SSH access - never tracked, ever
/deploy/ssh/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# user-uploaded content (avatars, memory photos)
/public/uploads/*
!/public/uploads/.gitkeep
!.env.example

# private keys and credentials, wherever they end up
/deploy/
*.key
*_key
id_rsa*
id_ed25519*

# local databases and dumps
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.dump

# AI-agent tooling clutter (not part of the project)
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
/AGENTS.md
/CLAUDE.md
